# Konfigurasi Server Forte
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Batasan Unduhan
MAX_DURATION_MINUTES=60
MAX_FILE_SIZE_MB=500

# Rate Limiting (permintaan per menit per IP)
RATE_LIMIT_PER_MINUTE=10

# Pembersihan File Sementara
TEMP_DIR=temp_downloads
CLEANUP_MAX_AGE_MINUTES=15
CLEANUP_INTERVAL_SECONDS=120

# Opsional: Path ke file cookies Netscape (jika diperlukan untuk konten publik Instagram/Facebook tertentu)
COOKIES_FILE=

